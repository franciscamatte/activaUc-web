# =====================================================================
# ActivaUC · acceso a la base de datos (sólo para operadores)
# ---------------------------------------------------------------------
#   cp .env.db.example .env.db
#   # pon tu contraseña abajo
#   bash scripts/db-connect-test.sh
#
# Ese último comando prueba la conexión directa y los Session pooler, y
# escribe aquí la variante que funciona.
#
# .env.db está en .gitignore y NUNCA debe versionarse.
#
# La usan scripts/seed-usuarios.sh y la programación de tareas
# (supabase/cron/schedule.sql).
# =====================================================================

# Contraseña de la base de datos: la que guardaste al crear el proyecto.
# Si la perdiste, se restablece en:
#   Project Settings → Database → Reset database password
SUPABASE_DB_PASSWORD=TU_CLAVE

# Opcional: sólo si no se puede deducir de VITE_SUPABASE_URL en .env
# SUPABASE_PROJECT_REF=

# La escribe scripts/db-connect-test.sh. No la pongas a mano.
# SUPABASE_DB_URL=
