# =====================================================================
# ActivaUC · SECRETOS DE BACKEND (Supabase Edge Functions)
# ---------------------------------------------------------------------
# Copia este archivo a .env.secrets, completa los valores y cárgalos con:
#
#   cp .env.secrets.example .env.secrets
#   bash scripts/set-secrets.sh
#
# .env.secrets está en .gitignore y NUNCA debe versionarse ni subirse.
# Ninguno de estos valores llega al navegador: viven sólo como secretos
# de las Edge Functions.
#
# Este archivo contiene únicamente NOMBRES de variables y ejemplos de
# formato, jamás credenciales reales.
# =====================================================================

# ---------------------------------------------------------------------
# Cifrado de tokens OAuth en reposo
# ---------------------------------------------------------------------
# Clave AES-256-GCM: exactamente 32 bytes en base64. Generar con:
#   openssl rand -base64 32
# Rotarla invalida los tokens ya guardados: las personas deberán volver
# a conectar su Google Calendar (ver docs/SEGURIDAD.md).
ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# Autenticación de las tareas programadas
# ---------------------------------------------------------------------
# Secreto compartido entre pg_cron y los workers de integración.
# Generar con: openssl rand -hex 32
# Debe cargarse también en la base de datos con supabase/cron/schedule.sql
CRON_SECRET=

# ---------------------------------------------------------------------
# Google Calendar (Google Cloud → APIs y servicios → Credenciales)
# ---------------------------------------------------------------------
# Ver docs/CONFIGURACION_GOOGLE_CALENDAR.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URI de redirección. Debe coincidir EXACTAMENTE, carácter por carácter,
# con la registrada en el cliente OAuth de Google.
GOOGLE_REDIRECT_URI=https://TU-PROYECTO.supabase.co/functions/v1/google-oauth-callback

# ---------------------------------------------------------------------
# Twilio WhatsApp (Twilio Console)
# ---------------------------------------------------------------------
# Ver docs/CONFIGURACION_TWILIO_WHATSAPP.md
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Número emisor en formato E.164. En el Sandbox es el número que muestra
# TU consola: depende de la cuenta, no es siempre el +14155238886 de los
# tutoriales. Enviar desde otro falla con 21654 sin decir que el From está
# mal (ver docs/CONFIGURACION_TWILIO_WHATSAPP.md § 2).
# Descoméntalo junto con las credenciales: el grupo es todo o nada.
# TWILIO_WHATSAPP_FROM=+1XXXXXXXXXX

# Webhook público al que Twilio informa los estados de entrega.
TWILIO_STATUS_CALLBACK_URL=https://TU-PROYECTO.supabase.co/functions/v1/twilio-status-webhook

# URL exacta que Twilio usa para firmar. Sólo hace falta si hay un proxy
# que altera el host y la reconstrucción automática no coincide.
# TWILIO_WEBHOOK_URL=

# ---------------------------------------------------------------------
# Plantillas aprobadas de WhatsApp (obligatorias en producción)
# ---------------------------------------------------------------------
# Identificadores de contenido (ContentSid, empiezan con HX) de las
# plantillas aprobadas. Si se dejan vacíos, los mensajes salen como texto
# libre, que sólo funciona en el Sandbox y dentro de la ventana de 24 h.
TWILIO_CONTENT_SID_CONFIRMACION=
TWILIO_CONTENT_SID_RECORDATORIO=
TWILIO_CONTENT_SID_CANCELACION=

# Orden en que la plantilla espera sus variables. Vacío = el de ActivaUC
# (nombre, recinto, fechaHora, y motivo en la cancelación). Sirve para dos
# casos reales: una plantilla aprobada por Meta con las variables en otro
# orden, y las plantillas de muestra de Twilio —las únicas disponibles en
# cuenta Trial—, que traen el texto fijo y no aceptan ninguna variable.
#
#   TWILIO_CONTENT_VARS_CONFIRMACION=ninguna              # plantilla sin variables
#   TWILIO_CONTENT_VARS_CONFIRMACION=recinto,fechaHora,nombre
#
# Campos admitidos: nombre, recinto, fechaHora, motivo.
TWILIO_CONTENT_VARS_CONFIRMACION=
TWILIO_CONTENT_VARS_RECORDATORIO=
TWILIO_CONTENT_VARS_CANCELACION=

# ---------------------------------------------------------------------
# Canal de correo (alternativa a WhatsApp, a elección de cada persona)
# ---------------------------------------------------------------------
# Usa la misma cuenta de Twilio, por comms.twilio.com/v1/Emails. El
# contenido es libre, también en cuenta Trial.
#
# Remitente. Si se deja vacío se usa <TWILIO_ACCOUNT_SID>@twilio.email,
# que es el del plan de prueba. Para producción hay que verificar un
# dominio propio en Twilio y ponerlo aquí: un correo desde un dominio
# ajeno llega mal a destinatarios institucionales.
TWILIO_EMAIL_FROM=
TWILIO_EMAIL_FROM_NAME=ActivaUC

# En cuenta Trial, Twilio exige que el contenido del correo coincida
# EXACTAMENTE con una de sus plantillas de muestra, o responde 400
# «Invalid template: email content does not match any approved
# template». Estas dos variables fijan ese contenido para poder ejercer
# la cadena completa sin pagar. El texto hay que copiarlo de la consola
# (Messaging -> Try it out -> Send an email), tal cual, sin cambiar ni
# un carácter.
#
# Al salir de Trial se vacían: entonces se envían el asunto y el cuerpo
# propios de ActivaUC, con los datos de la reserva.
#
# OJO: este archivo lo interpreta el shell, así que todo valor con
# espacios va entre comillas simples, o la carga falla.
#   TWILIO_EMAIL_ASUNTO_FIJO='Reminder: Your Upcoming Appointment'
TWILIO_EMAIL_ASUNTO_FIJO=
TWILIO_EMAIL_HTML_FIJO=

# ---------------------------------------------------------------------
# Canal de correo por Brevo (preferido sobre el de Twilio)
# ---------------------------------------------------------------------
# Si BREVO_API_KEY está definida, las notificaciones por correo salen
# por Brevo y no por Twilio. El motivo: en el plan de prueba de Twilio
# ese canal exige que el contenido coincida con una plantilla de muestra
# y que cada destinatario esté verificado (error 574002), lo que lo deja
# inservible con terceros. Brevo no tiene ninguna de las dos
# restricciones en su plan gratuito.
#
# OJO: aquí va la API key (empieza con «xkeysib-»), que NO es la SMTP
# key que usa Supabase para sus correos de autenticación. Están en
# pantallas distintas del mismo menú de Brevo.
#
# Permiso necesario al generarla: «Emails transaccionales · Todos», y
# todo lo demás en «Ninguno». Es el único recurso que usa el código.
# Caduca tras 90 días sin uso, aparte de su vencimiento propio.
BREVO_API_KEY=

# Remitente verificado en Brevo. Debe coincidir exactamente con uno de
# los que aparecen en Remitentes, dominios e IP dedicadas.
BREVO_EMAIL_FROM=
BREVO_EMAIL_FROM_NAME=ActivaUC

# ---------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------
# Origen público del frontend: se usa para redirigir al terminar OAuth.
APP_URL=https://activauc.ejemplo.cl

# Orígenes permitidos para CORS, separados por comas. Si se omite, se
# permite únicamente APP_URL.
APP_ALLOWED_ORIGINS=https://activauc.ejemplo.cl

# Zona horaria con la que se construyen los eventos de calendario y los
# textos de los mensajes.
APP_TIME_ZONE=America/Santiago

# =====================================================================
# NO definir aquí (Supabase las inyecta en cada Edge Function, y
# rechazará cargarlas como secretos):
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_DB_URL
# =====================================================================
