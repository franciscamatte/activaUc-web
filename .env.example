# =====================================================================
# ActivaUC · variables PÚBLICAS del frontend
# ---------------------------------------------------------------------
# Copia este archivo a .env y completa los valores.
#
#   cp .env.example .env
#
# IMPORTANTE: todo lo que empieza con VITE_ se COMPILA DENTRO DEL
# PAQUETE JAVASCRIPT y es visible para cualquiera que abra el sitio.
# Aquí sólo van valores públicos.
#
# Los secretos de backend (service role, Google, Twilio, cifrado, cron)
# NO van en este archivo: son secretos de Supabase Edge Functions.
# Para ésos usa .env.secrets (ver .env.secrets.example).
# =====================================================================

# ---------------------------------------------------------------------
# Modo de datos
# ---------------------------------------------------------------------
# supabase → backend real (valor por omisión y único válido en producción)
# mock     → datos de ejemplo en memoria, SÓLO para desarrollo local.
#            Una compilación de producción con mock es rechazada por la
#            propia aplicación, para que no se confunda con el sistema real.
VITE_DATA_MODE=supabase

# ---------------------------------------------------------------------
# Supabase (Project Settings → API)
# ---------------------------------------------------------------------
# URL del proyecto.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave "anon" / "publishable". Es pública por diseño: todo el acceso
# queda limitado por las políticas RLS.
# NUNCA pongas aquí la service_role key: la aplicación la detecta y se
# niega a arrancar, pero de todos modos quedaría publicada en el bundle.
VITE_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY

# ---------------------------------------------------------------------
# URLs de la aplicación
# ---------------------------------------------------------------------
# Origen público del frontend. Se usa para construir los enlaces de
# confirmación de correo y de recuperación de contraseña.
# Debe coincidir con las "Redirect URLs" configuradas en Supabase Auth.
# En desarrollo: http://localhost:5173
# Origen público del frontend. DÉJALO VACÍO salvo que tengas un motivo:
# vacío, la aplicación usa el origen desde el que se la sirve
# (window.location.origin), con lo que el MISMO archivo compilado
# funciona en localhost y en el dominio que publiques.
#
# Si le pones un valor, ese valor queda DENTRO del compilado, y publicar
# un build hecho con «http://localhost:5173» rompe la confirmación de
# correo y la conexión con Google, que redirigen ahí.
VITE_APP_URL=

# URL base de las Edge Functions. Opcional: por omisión se deriva como
# <VITE_SUPABASE_URL>/functions/v1
# VITE_SUPABASE_FUNCTIONS_URL=https://TU-PROYECTO.supabase.co/functions/v1

# ---------------------------------------------------------------------
# Presentación
# ---------------------------------------------------------------------
# Zona horaria con la que se muestran e interpretan fechas y horas.
VITE_TIME_ZONE=America/Santiago
